{
  "name": "@lennix1337/pi-browser-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Native Pi browser control backed by browser-use/browser-harness, with explicit owned tabs.",
  "license": "MIT",
  "author": "lennix1337",
  "keywords": [
    "pi-package",
    "pi-extension",
    "browser"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "mutations": "node test/mutations.mjs",
    "setup": "uv sync --frozen --python 3.12",
    "browser": "node scripts/browser.mjs",
    "smoke": "node --import tsx test/browser-smoke.ts"
  },
  "dependencies": {
    "typebox": "1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "undici": "8.12.3"
  },
  "engines": {
    "node": ">=24.2.0"
  }
}
